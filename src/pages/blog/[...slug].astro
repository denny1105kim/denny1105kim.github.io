---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, fmtDate } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i + 1], next: posts[i - 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const words = post.body?.trim().split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.round(words / 200));
---
<Base title={post.data.title} description={post.data.description}>
  <article style="margin-top: 32px">
    <a href="/blog/" class="link muted back animate">← Back to blog</a>
    <header class="animate" style="animation-delay: 60ms">
      <div class="meta faint">
        <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
        <span>·</span>
        <span>{minutes} min read</span>
      </div>
      <h1>{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <div class="tags">{post.data.tags.map((t) => <span class="tag">#{t}</span>)}</div>
      )}
    </header>
    <div class="prose animate" style="animation-delay: 120ms">
      <Content />
    </div>
  </article>

  <nav class="pager">
    {prev ? (
      <a class="card" href={`/blog/${prev.id}/`}><div><div class="faint small">← Previous</div><div class="card-title">{prev.data.title}</div></div></a>
    ) : <span />}
    {next ? (
      <a class="card right" href={`/blog/${next.id}/`}><div><div class="faint small">Next →</div><div class="card-title">{next.data.title}</div></div></a>
    ) : <span />}
  </nav>
</Base>
<style>
  .back { font-size: 0.85rem; display: inline-block; margin-bottom: 28px; }
  .meta { display: flex; gap: 8px; font-size: 0.85rem; }
  h1 { font-size: 1.75rem; line-height: 1.3; letter-spacing: -0.025em; margin: 6px 0 4px; }
  header { margin-bottom: 36px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 64px; }
  .pager .right { text-align: right; justify-content: flex-end; }
  .small { font-size: 0.78rem; }
  @media (max-width: 520px) { .pager { grid-template-columns: 1fr; } }
</style>
