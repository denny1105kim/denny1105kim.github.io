---
import Base from '../../layouts/Base.astro';
import { getPosts, fmtDate } from '../../utils';

const posts = await getPosts();
const byYear = Object.entries(
  posts.reduce<Record<string, typeof posts>>((acc, p) => {
    const y = String(p.data.date.getFullYear());
    (acc[y] ??= []).push(p);
    return acc;
  }, {}),
).sort((a, b) => Number(b[0]) - Number(a[0]));
---
<Base title="Blog" description="Notes on embedded Linux, NPU, and Edge AI.">
  <div class="animate" style="margin-top: 32px">
    <h1>Blog</h1>
    <p class="muted">임베디드, NPU, Edge AI에 대해 공부하고 일하며 배운 것들.</p>
  </div>

  {posts.length === 0 && <p class="muted">아직 글이 없어요.</p>}

  {byYear.map(([year, list], i) => (
    <section class="animate" style={`margin-top: 48px; animation-delay: ${80 + i * 60}ms`}>
      <h2 class="section-title year">{year}</h2>
      <ul class="card-list">
        {list.map((p) => (
          <li>
            <a class="card" href={`/blog/${p.id}/`}>
              <div>
                <div class="card-title">{p.data.title}</div>
                <div class="card-desc">{p.data.description}</div>
              </div>
              <time class="faint date" datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
<style>
  h1 { font-size: 1.6rem; letter-spacing: -0.025em; margin: 0 0 6px; }
  .year { margin-bottom: 14px; color: var(--muted); }
  .date { font-size: 0.8rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  @media (max-width: 520px) { .date { display: none; } }
</style>
