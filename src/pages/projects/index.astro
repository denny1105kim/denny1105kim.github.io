---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getProjects } from '../../utils';
const projects = await getProjects();
---
<Base title="Projects" description="Research, work, and personal projects.">
  <div class="animate" style="margin-top: 32px">
    <h1>Projects</h1>
    <p class="muted">From local LLM & RAG research to GPU platforms, edge AI optimization, and side projects.</p>
  </div>
  <section class="animate" style="margin-top: 36px; animation-delay: 80ms">
    <ProjectList projects={projects} />
  </section>
</Base>
<style>
  h1 { font-size: 1.6rem; letter-spacing: -0.025em; margin: 0 0 6px; }
</style>
