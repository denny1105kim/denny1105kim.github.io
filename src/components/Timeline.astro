---
interface Item { period: string; title: string; org: string; detail?: string }
const { items } = Astro.props as { items: Item[] };
---
<ol>
  {items.map((it) => (
    <li>
      <div class="period">{it.period}</div>
      <div>
        <div class="title">{it.title}</div>
        <div class="org">{it.org}</div>
        {it.detail && <div class="detail">{it.detail}</div>}
      </div>
    </li>
  ))}
</ol>
<style>
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  li { display: grid; grid-template-columns: 150px 1fr; gap: 16px; }
  .period { color: var(--faint); font-size: 0.85rem; padding-top: 2px; font-variant-numeric: tabular-nums; }
  .title { font-weight: 500; font-size: 0.95rem; line-height: 1.5; }
  .org { color: var(--muted); font-size: 0.88rem; line-height: 1.5; }
  .detail { color: var(--muted); font-size: 0.85rem; line-height: 1.6; margin-top: 4px; }
  @media (max-width: 520px) {
    li { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
