---
import { SITE } from '../site';
const path = Astro.url.pathname;
const nav = [
  { href: '/projects/', label: 'projects' },
  { href: '/#research', label: 'research' },
  { href: '/blog/', label: 'blog' },
];
---
<header class="container header">
  <a href="/" class="brand"><span class="full">{SITE.name}</span><span class="short">{SITE.shortName}</span></a>
  <nav>
    {nav.map((n, i) => (
      <>
        {i > 0 && <span class="faint">/</span>}
        <a href={n.href} class:list={['link', { active: !n.href.includes('#') && path.startsWith(n.href) }]}>{n.label}</a>
      </>
    ))}
    <button id="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
      <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
  });
</script>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 28px;
    padding-bottom: 28px;
    font-size: 0.9rem;
  }
  .brand { font-weight: 600; text-decoration: none; letter-spacing: -0.01em; }
  nav { display: flex; align-items: center; gap: 8px; color: var(--muted); }
  nav a:hover, nav a.active { color: var(--fg); }
  nav a.active { text-decoration-color: currentColor; }
  button {
    margin-left: 10px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }
  button:hover { color: var(--fg); background: var(--card-hover); }
  .short { display: none; }
  @media (max-width: 440px) {
    .full { display: none; }
    .short { display: inline; }
    nav { gap: 6px; }
    button { margin-left: 4px; }
  }
  .moon { display: none; }
  :global(:root.dark) .sun { display: none; }
  :global(:root.dark) .moon { display: block; }
</style>
