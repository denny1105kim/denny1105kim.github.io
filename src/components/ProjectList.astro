---
import type { Project } from '../utils';
const { projects } = Astro.props as { projects: Project[] };
---
{projects.length === 0 ? (
  <p class="muted">Coming soon.</p>
) : (
  <ul class="grid">
    {projects.map((p, i) => (
      <li>
        <a class="pcard" href={`/projects/${p.id}/`}>
          {p.data.cover && (
            <div class:list={['cover', { diagram: p.data.cover.endsWith('.svg') }]}>
              <img src={p.data.cover} alt={p.data.coverAlt} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            </div>
          )}
          <div class="body">
            <h3>{p.data.title} <span class="arrow" aria-hidden="true">→</span></h3>
            <p class="desc">{p.data.description}</p>
            <p class="meta">{p.data.period} · {p.data.kind}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
)}
<style>
  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px;
  }
  .grid > li { min-width: 0; }
  .pcard { display: block; text-decoration: none; }

  /* Same 16:9 frame for every cover. Photos fill it; diagrams fit inside. */
  .cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #f6f7f6;
  }
  .cover img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cover.diagram img { object-fit: contain; }
  .pcard:hover .cover img { transform: scale(1.03); }

  .body { padding: 12px 2px 0; }
  h3 { margin: 0; font-size: 1rem; letter-spacing: -0.015em; line-height: 1.45; }
  .arrow { display: inline-block; color: var(--faint); font-weight: 400; transition: transform 0.15s, color 0.15s; }
  .pcard:hover .arrow { transform: translateX(3px); color: var(--fg); }
  .desc { margin: 4px 0 0; color: var(--muted); font-size: 0.86rem; line-height: 1.6; }
  .meta { margin: 6px 0 0; color: var(--faint); font-size: 0.76rem; }

  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; gap: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover img, .arrow { transition: none; }
    .pcard:hover .cover img { transform: none; }
  }
</style>
